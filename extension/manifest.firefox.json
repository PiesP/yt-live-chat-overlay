{
  "manifest_version": 3,
  "name": "YouTube Live Chat Overlay",
  "version": "0.37.0",
  "description": "Nico-nico style comment overlay for YouTube live chat. 100% local processing.",
  "author": "PiesP",
  "homepage_url": "https://github.com/PiesP/yt-live-chat-overlay",

  "browser_specific_settings": {
    "gecko": {
      "id": "yt-live-chat-overlay@piesp.github.io",
      "strict_min_version": "128.0"
    }
  },

  "permissions": [
    "storage",
    "menus"
  ],

  "host_permissions": [
    "https://www.youtube.com/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["workers/*.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],

  "background": {
    "scripts": ["background.js"]
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
