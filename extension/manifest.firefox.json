{
  "manifest_version": 3,
  "name": "YouTube Live Chat Overlay",
  "version": "0.45.2",
  "description": "In-browser NicoNico-style comment overlay for YouTube live chat.",
  "author": "PiesP",
  "homepage_url": "https://github.com/PiesP/yt-live-chat-overlay",
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-live-chat-overlay@piesp.github.io",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "storage",
    "menus"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_end",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "workers/*.js",
        "page-script.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; worker-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
