{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // Target & Libraries
    "target": "ESNext",
    "lib": [
      "ESNext",
      "DOM",
    ],
    // Determines ordering for union/intersection types (matches TS 7.0 Go port)
    "stableTypeOrdering": true,
    // Module System (bundler mode for Vite compatibility)
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Strict Type Checking
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    // Module handling
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    // Emit
    "noEmit": true,
    "skipLibCheck": true,
    // Path Aliases
    "paths": {
      "@core/*": [
        "./src/core/*"
      ],
      "@util/*": [
        "./src/util/*"
      ],
      "@i18n/*": [
        "./src/i18n/*"
      ],
      "@app-types": [
        "./src/types/index"
      ],
      "@platform/*": [
        "./src/platform/*"
      ]
    },
    // Build Performance
    "incremental": true,
    "tsBuildInfoFile": ".vscode/.tsbuildinfo",
    // Compatibility
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "extension",
    ".vscode"
  ]
}
