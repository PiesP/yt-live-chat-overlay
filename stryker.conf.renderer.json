{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-schema.json",
  "mutate": [
    "src/renderer/canvas/shared.ts:540-620",
    "src/renderer/canvas/pipeline-utils.ts",
    "src/renderer/color-utils.ts",
    "src/renderer/worker/protocol-guards.ts"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false
  },
  "reporters": ["progress", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/renderer.json"
  },
  "coverageAnalysis": "perTest",
  "inPlace": true,
  "ignoreStatic": true,
  "thresholds": {
    "high": 70,
    "low": 60,
    "break": 60
  },
  "concurrency": 2,
  "timeoutMS": 60000,
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutator": {
    "excludedMutations": [
      "ArrayDeclaration",
      "ObjectLiteral",
      "ArrowFunction",
      "BlockStatement",
      "ConditionalExpression",
      "Regex",
      "UnaryOperator",
      "UpdateOperator",
      "OptionalChaining",
      "PrefixDecrementOperator",
      "PrefixIncrementOperator",
      "PostfixDecrementOperator",
      "PostfixIncrementOperator",
      "MethodExpression",
      "NonNullAssertion",
      "CheckedStatement",
      "SwitchCase",
      "WhileStatement",
      "ForStatement"
    ]
  }
}
