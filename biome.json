{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "master"
  },
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "extension/**/*.ts",
      "test/**",
      "tooling/**",
      "validation/windows/**/*.mjs",
      "validation/windows/**/*.json",
      ".github/actions/**/*.mjs",
      "*.ts",
      "*.json",
      "!!**/node_modules",
      "!!packages/core",
      "!!**/dist*",
      "!!**/coverage",
      "!!**/reports",
      "!!**/test-results",
      "!!**/playwright-report",
      "!!**/.stryker-tmp*",
      "!!**/.cache",
      "!!**/browser-profiles",
      "!!**/vendor"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": "warn",
        "noUnknownMediaFeatureName": "off",
        "noUnknownPseudoElement": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useConst": "error",
        "noParameterAssign": "warn",
        "noUnusedTemplateLiteral": "error",
        "useExponentiationOperator": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConfusingVoidType": "off",
        "noControlCharactersInRegex": "off",
        "noAssignInExpressions": "off",
        "noDocumentCookie": "off",
        "noSelfCompare": "warn",
        "noArrayIndexKey": "off",
        "noImplicitAnyLet": "error",
        "useIterableCallbackReturn": "error"
      },
      "complexity": {
        "noForEach": "off",
        "noStaticOnlyClass": "off",
        "noUselessTernary": "error",
        "noUselessSwitchCase": "error",
        "noUselessEmptyExport": "error",
        "noUselessLoneBlockStatements": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error"
      },
      "a11y": {
        "noStaticElementInteractions": "error",
        "useKeyWithClickEvents": "error",
        "useMediaCaption": "off",
        "noSvgWithoutTitle": "error",
        "useAriaPropsSupportedByRole": "error",
        "useSemanticElements": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "es5",
      "arrowParentheses": "always",
      "lineEnding": "lf"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
