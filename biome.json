{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "master"
  },
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "extension/**/*.ts",
      "test/**",
      "tooling/**",
      "validation/windows/**/*.mjs",
      "validation/windows/**/*.json",
      ".github/actions/**/*.mjs",
      "*.ts",
      "*.json",
      "!!**/node_modules",
      "!!packages/core",
      "!!**/dist*",
      "!!**/coverage",
      "!!**/reports",
      "!!**/test-results",
      "!!**/playwright-report",
      "!!**/.stryker-tmp*",
      "!!**/.cache",
      "!!**/browser-profiles",
      "!!**/vendor"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useConst": "error",
        "noParameterAssign": "warn",
        "noUnusedTemplateLiteral": "error",
        "useExponentiationOperator": "error",
        "useImportType": {
          "level": "error",
          "options": {
            "style": "auto"
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noImplicitAnyLet": "error"
      },
      "complexity": {
        "noStaticOnlyClass": "off",
        "noUselessTernary": "error",
        "noUselessSwitchCase": "error",
        "noUselessEmptyExport": "error",
        "noUselessLoneBlockStatements": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "es5",
      "arrowParentheses": "always",
      "lineEnding": "lf"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "extension/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "error"
          }
        }
      }
    },
    {
      "includes": ["test/**", "scripts/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/chat/message-helpers.ts",
        "src/settings/schema.ts",
        "validation/windows/chrome-install.mjs"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noControlCharactersInRegex": "off"
          }
        }
      }
    },
    {
      "includes": ["src/platform/chrome-types.d.ts", "src/renderer/canvas/shared.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConfusingVoidType": "off"
          }
        }
      }
    },
    {
      "includes": [
        "test/unit/app/standby-controller.test.ts",
        "test/unit/settings/ui/controller.test.ts",
        "test/unit/worker/manager.test.ts",
        "test/unit/worker/renderer.test.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": [
        "test/unit/core/canvas-render-mock.test.ts",
        "test/unit/core/vertical-spacing.test.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noConstructorReturn": "off"
          }
        }
      }
    },
    {
      "includes": [
        "validation/windows/chrome-install.mjs",
        "validation/windows/natural-chrome.mjs"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnsafeFinally": "off"
          }
        }
      }
    }
  ]
}
