#!/usr/bin/env bash
set -euo pipefail

branch="$(git symbolic-ref --quiet --short HEAD || true)"

if [[ -z "$branch" ]]; then
  echo "Commits from a detached HEAD are blocked. Create a work branch first." >&2
  exit 1
fi

if [[ "$branch" == "master" || "$branch" == "main" ]]; then
  echo "Commits on '$branch' are blocked. Commit on a work branch and use the protected PR path." >&2
  exit 1
fi
