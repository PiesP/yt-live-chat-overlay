#!/usr/bin/env bash
set -euo pipefail

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/master|refs/heads/main)
      echo "Direct pushes to the default branch are blocked. Push a work branch and use the protected PR path." >&2
      exit 1
      ;;
    *) continue ;;
  esac
done
