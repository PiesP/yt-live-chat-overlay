{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "src/main.ts!",
    "src/renderer/worker/renderer.ts!",
    "extension/background.ts!",
    "extension/content-script.ts!",
    "extension/page-script.ts!",
    "scripts/**/*.ts",
    "vite.config.*.ts"
  ],
  "project": [
    "src/**/*.ts!",
    "extension/**/*.ts!",
    "scripts/**/*.ts",
    "tooling/**/*.ts",
    "vite*.ts",
    "test/**/*.ts"
  ],
  "paths": {
    "@app/*": ["src/app/*"],
    "@chat/*": ["src/chat/*"],
    "@i18n/*": ["src/i18n/*"],
    "@media/*": ["src/media/*"],
    "@renderer/*": ["src/renderer/*"],
    "@settings/*": ["src/settings/*"],
    "@translation/*": ["src/translation/*"],
    "@util/*": ["src/util/*"],
    "@app-types": ["src/types/index"],
    "@platform/*": ["src/platform/*"]
  },
  "ignoreExportsUsedInFile": true,
  "playwright": {
    "config": ["test/e2e/playwright.config.ts"],
    "entry": ["test/e2e/specs/**/*.spec.ts"]
  }
}
