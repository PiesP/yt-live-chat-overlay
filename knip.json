{
  "$schema": "./node_modules/knip/schema.json",
  "entry": ["src/main.ts"],
  "project": ["src/**/*.ts", "src/**/*.tsx"],
  "paths": {
    "@core/*": ["src/core/*"],
    "@app-types": ["src/types/index"],
    "@platform/*": ["src/platform/*"]
  },
  "ignoreBinaries": ["vitest"],
  "ignore": ["test/**", "extension/**", "dist*/**"]
}
