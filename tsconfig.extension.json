{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@util/*": ["./src/util/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@chat/*": ["./src/chat/*"],
      "@chat/youtube/*": ["./src/chat/youtube/*"],
      "@settings/*": ["./src/settings/*"],
      "@renderer/*": ["./src/renderer/*"],
      "@app/*": ["./src/app/*"],
      "@translation/*": ["./src/translation/*"],
      "@media/*": ["./src/media/*"],
      "@app-types": ["./src/types/index"],
      "@platform/*": ["./src/platform/*"]
    }
  },
  "include": [
    "extension/**/*.ts",
    "src/types/globals.d.ts",
    "src/platform/chrome-types.d.ts",
    "src/platform/extension-bridge.d.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-extension", "dist-extension-firefox", ".vscode"]
}
