{
  "name": "yt-live-chat-overlay",
  "version": "0.25.0",
  "description": "Nico-nico style comment overlay for YouTube live chat (100% local processing)",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "dev": "vite build --mode development --watch",
    "check": "tsc --noEmit",
    "knip": "knip --dependencies",
    "knip:full": "knip --files --exports --dependencies --reporter compact --max-show-issues 50 --no-exit-code",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "fmt": "biome check --linter-enabled=false .",
    "fmt:fix": "biome check --write --linter-enabled=false .",
    "circular": "pnpm dlx madge --ts-config tsconfig.json --circular src/core/*.ts",
    "quality": "pnpm -s fmt && pnpm -s lint && pnpm -s check && pnpm -s circular && pnpm -s knip",
    "quality:fix": "pnpm -s fmt:fix && pnpm -s lint:fix && pnpm -s check && pnpm -s circular && pnpm -s knip",
    "clean": "rm -rf dist",
    "prebuild": "pnpm quality"
  },
  "keywords": [
    "userscript",
    "youtube",
    "live-chat",
    "overlay",
    "nico-nico"
  ],
  "author": "PiesP",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.29.2"
  },
  "packageManager": "pnpm@10.29.2",
  "volta": {
    "node": "24.15.0",
    "pnpm": "10.29.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^25.6.2",
    "knip": "^6.12.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vite-plugin-monkey": "^8.0.1"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=3.0.0 <3.1.3": "3.1.5"
    }
  }
}
