{
  "name": "yt-live-chat-overlay",
  "version": "0.45.9",
  "description": "In-browser NicoNico-style comment overlay for YouTube live chat.",
  "type": "module",
  "private": true,
  "scripts": {
    "preinstall": "node --experimental-strip-types scripts/check/bootstrap.ts",
    "build": "vp build",
    "build:dev": "vp build --mode development",
    "dev": "vp build --mode development --watch",
    "check": "tsc --noEmit",
    "check:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "check:windows": "tsc -p tsconfig.windows.json --noEmit",
    "check:extension": "tsc -p tsconfig.extension.json --noEmit",
    "typecheck": "vp run check",
    "lint": "vp lint --deny-warnings src scripts extension test tooling validation/windows .github/actions '*.ts' '*.json'",
    "lint:fix": "vp lint --fix --deny-warnings src scripts extension test tooling validation/windows .github/actions '*.ts' '*.json'",
    "fmt": "vp fmt --check src scripts extension test tooling validation/windows .github/actions '*.ts' '*.json'",
    "fmt:fix": "vp fmt --write src scripts extension test tooling validation/windows .github/actions '*.ts' '*.json'",
    "fmt:check": "vp run fmt",
    "check:test": "tsc -p tsconfig.test.json --noEmit",
    "check:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "quality": "vp run quality-gate",
    "quality:fix": "vp run quality-fix-gate",
    "check:artifacts": "node --experimental-strip-types scripts/check/artifacts.ts",
    "verify": "vp run verify-gate",
    "verify:full": "vp run verify-full-gate",
    "clean": "node --experimental-strip-types scripts/build/clean.ts",
    "validate:consistency": "vp test run test/consistency/",
    "check:versions": "node --experimental-strip-types scripts/release/version.ts check",
    "sync:versions": "node --experimental-strip-types scripts/release/version.ts sync",
    "check:prebuild": "vp run prebuild-gate",
    "prebuild": "vp run check:prebuild",
    "prebuild:extension": "vp run check:prebuild",
    "prebuild:extension:firefox": "vp run check:prebuild",
    "prebuild:all": "vp run check:prebuild",
    "build:ci": "vp build",
    "build:extension:ci": "vp run chrome-build",
    "build:extension": "vp run chrome-build",
    "build:extension:dev": "vp run chrome-dev-build",
    "build:extension:firefox:ci": "vp run firefox-build",
    "build:extension:firefox": "vp run firefox-build",
    "build:targets:ci": "node --experimental-strip-types scripts/build/targets.ts",
    "build:all": "vp run build:targets:ci",
    "build:all:ci": "vp run build-all-ci-gate",
    "release:prepare": "node --experimental-strip-types scripts/release/prepare.ts",
    "test": "vp test run --project=unit --project=browser",
    "test:ci": "vp test run --project=node-policy",
    "test:core": "vp run core-verify",
    "test:watch": "vp test watch --project=unit --project=browser",
    "test:cov": "vp test run --coverage --project=unit --project=browser",
    "test:e2e": "playwright test --config test/e2e/playwright.config.ts",
    "test:e2e:headed": "vp run test:e2e --headed",
    "test:e2e:prepared": "vp run e2e-prepared",
    "pretest:e2e": "vp run e2e-prepare",
    "clean:all": "vp run clean",
    "check:i18n": "node --experimental-strip-types scripts/check/i18n.ts"
  },
  "keywords": [
    "userscript",
    "youtube",
    "live-chat",
    "overlay",
    "nico-nico",
    "browser-extension"
  ],
  "author": "PiesP",
  "license": "MIT",
  "homepage": "https://github.com/PiesP/yt-live-chat-overlay",
  "bugs": "https://github.com/PiesP/yt-live-chat-overlay/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PiesP/yt-live-chat-overlay.git"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1",
    "pnpm": ">=12.14.0"
  },
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@piesp/browser-core": "file:packages/core",
    "bidi-js": "1.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "catalog:",
    "playwright": "1.64.1",
    "puppeteer-core": "25.16.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plugin-monkey": "^8.1.1",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
