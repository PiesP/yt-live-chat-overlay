{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-schema.json",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.d.ts",
    "!src/types/**",
    "!src/main.ts",
    "!src/renderer/**",
    "!src/chat/**",
    "!src/app/chat-availability-preflight.ts",
    "!src/app/overlay.ts",
    "!src/app/runtime-manager.ts",
    "!src/app/standby-controller.ts",
    "!src/app/video-pause-controller.ts",
    "!src/media/image-fetch-manager.ts",
    "!src/platform/menu-adapters.ts",
    "!src/platform/storage-adapters.ts",
    "!src/platform/worker-factory.ts",
    "!src/settings/store.ts",
    "!src/settings/ui/controller.ts",
    "!src/settings/ui/form.ts",
    "!src/settings/ui/panes.ts",
    "!src/settings/ui/styles.ts",
    "!src/translation/service.ts",
    "!src/translation/language-detector.ts",
    "!src/util/backlog-indicator.ts",
    "!src/util/backlog-sampler.ts",
    "!src/util/observability.ts"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false
  },
  "reporters": ["progress", "clear-text", "json", "html"],
  "jsonReporter": {
    "fileName": "reports/mutation/fast.json"
  },
  "coverageAnalysis": "perTest",
  "inPlace": true,
  "ignoreStatic": true,
  "thresholds": {
    "high": 75,
    "low": 70,
    "break": 65
  },
  "concurrency": 2,
  "timeoutMS": 60000,
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayDeclaration",
      "ObjectLiteral",
      "ArrowFunction",
      "BlockStatement",
      "Regex",
      "UnaryOperator",
      "UpdateOperator",
      "OptionalChaining",
      "AssignmentOperator",
      "PrefixDecrementOperator",
      "PrefixIncrementOperator",
      "PostfixDecrementOperator",
      "PostfixIncrementOperator",
      "MethodExpression",
      "NonNullAssertion",
      "CheckedStatement",
      "SwitchCase",
      "WhileStatement",
      "ForStatement"
    ]
  }
}
